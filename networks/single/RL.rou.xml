<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="5" minGap="2.5" maxSpeed="13.89" guiShape="passenger"/>

    <!-- Random arrivals (probability per second), so every seed is different traffic.
         0-300 s is the warm-up (not measured), at the rates of the first period.
         Demand then shifts over the measured 1200 s so a fixed plan cannot fit all of it:
         300-700 s EB heavy, 700-1100 s balanced, 1100-1500 s SB heavy. -->
    <flow id="EB_0" type="car" begin="0"    end="300"  probability="0.4167" from="Node1_2_EB" to="Node2_3_EB" departLane="random"/>
    <flow id="SB_0" type="car" begin="0"    end="300"  probability="0.1389" from="Node2_7_SB" to="Node2_8_SB" departLane="random"/>
    <flow id="EB_1" type="car" begin="300"  end="700"  probability="0.4167" from="Node1_2_EB" to="Node2_3_EB" departLane="random"/>
    <flow id="SB_1" type="car" begin="300"  end="700"  probability="0.1389" from="Node2_7_SB" to="Node2_8_SB" departLane="random"/>
    <flow id="EB_2" type="car" begin="700"  end="1100" probability="0.2778" from="Node1_2_EB" to="Node2_3_EB" departLane="random"/>
    <flow id="SB_2" type="car" begin="700"  end="1100" probability="0.2778" from="Node2_7_SB" to="Node2_8_SB" departLane="random"/>
    <flow id="EB_3" type="car" begin="1100" end="1500" probability="0.1389" from="Node1_2_EB" to="Node2_3_EB" departLane="random"/>
    <flow id="SB_3" type="car" begin="1100" end="1500" probability="0.4167" from="Node2_7_SB" to="Node2_8_SB" departLane="random"/>
</routes>
